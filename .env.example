# Environment configuration example for Filadelfia Store

# Database configuration
DATABASE_URL=jdbc:mysql://localhost:3306/filadelfiastore
DATABASE_USERNAME=filadelfiastore
DATABASE_PASSWORD=12345678
DDL_AUTO=update
DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# Email configuration
# Use the SMTP host and credentials provided by your email provider.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=suporte@filadelfiastore.com
MAIL_PASSWORD=your-email-password
EMAIL_FROM=suporte@filadelfiastore.com

# Application configuration
BASE_URL=http://localhost:8080
